# Compose-level variables — read by docker compose itself for port mapping.
# These are NOT injected into containers; service env files handle that.

# ── API ───────────────────────────────────────────────────────────────────────
HONCHO_BIND=127.0.0.1
HONCHO_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DB_BIND=127.0.0.1
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
