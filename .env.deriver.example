# ══════════════════════════════════════════════════════════════════════════════
#  honcho-deriver service environment
#  All LLM inference routes through OpenRouter (openai-compatible transport).
# ══════════════════════════════════════════════════════════════════════════════

# ── Database + Cache (Docker service hostnames) ───────────────────────────────
DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@honcho-db:5432/postgres
CACHE_URL=redis://honcho-redis:6379/0?suppress=true
CACHE_ENABLED=true

# ── API Keys ──────────────────────────────────────────────────────────────────
LLM_OPENROUTER_API_KEY=sk-or-...   # https://openrouter.ai/keys

# ── Deriver — FREE — google/gemma-4-31b-it:free ($0.00 / 1M) ─────────────────
# High-frequency background worker; free model keeps cost at zero.
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=google/gemma-4-31b-it:free
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENROUTER_API_KEY
# DERIVER_ENABLED=true
# DERIVER_WORKERS=1
# DERIVER_POLLING_SLEEP_INTERVAL_SECONDS=1.0
# DERIVER_DEDUPLICATE=true
# DERIVER_MAX_INPUT_TOKENS=23000
# DERIVER_MODEL_CONFIG__MAX_OUTPUT_TOKENS=4096
# DERIVER_LOG_OBSERVATIONS=false

# ── Summary — FREE — google/gemma-4-31b-it:free ($0.00 / 1M) ─────────────────
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=google/gemma-4-31b-it:free
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
SUMMARY_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENROUTER_API_KEY
# SUMMARY_ENABLED=true
# SUMMARY_MESSAGES_PER_SHORT_SUMMARY=20
# SUMMARY_MESSAGES_PER_LONG_SUMMARY=60
# SUMMARY_MAX_TOKENS_SHORT=1000
# SUMMARY_MAX_TOKENS_LONG=4000

# ── Dream — PAID — deepseek/deepseek-v4-flash ($0.14 in / $0.28 out / 1M) ────
# Dream consolidation is infrequent (default: 8h minimum between runs) and
# requires stronger reasoning; DeepSeek V4 Flash is the sweet spot.
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=deepseek/deepseek-v4-flash
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENROUTER_API_KEY

DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=deepseek/deepseek-v4-flash
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENROUTER_API_KEY
# DREAM_ENABLED=true
# DREAM_IDLE_TIMEOUT_MINUTES=60
# DREAM_MIN_HOURS_BETWEEN_DREAMS=8
# DREAM_DOCUMENT_THRESHOLD=50
# DREAM_MAX_TOOL_ITERATIONS=20
